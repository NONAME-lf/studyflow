NODE_ENV=development
API_PORT=3001
APP_URL=http://localhost:3000

DATABASE_URL=postgresql://studyflow:studyflow@localhost:5433/studyflow
DATABASE_URL_TEST=postgresql://studyflow:studyflow@localhost:5433/studyflow_test

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="StudyFlow <no-reply@studyflow.dev>"
REMINDER_CRON="0 * * * *"
# Time zone of dates in e-mails (default: the server's zone). In production: Europe/Kyiv
APP_TIMEZONE=
