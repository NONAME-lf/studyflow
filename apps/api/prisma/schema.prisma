// StudyFlow data model — single source of truth (docs/domain-and-api.md §1).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  // Explicit: otherwise inferred from tsconfig.json, which is absent during `pnpm install` in Docker.
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum GroupRole {
  HEADMAN
  MEMBER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String   @map("password_hash")
  fullName           String   @map("full_name")
  refreshTokenHash   String?  @map("refresh_token_hash")
  reminderEnabled    Boolean  @default(true) @map("reminder_enabled")
  reminderDaysBefore Int      @default(1) @map("reminder_days_before")
  createdAt          DateTime @default(now()) @map("created_at")

  memberships    GroupMember[]
  ownedDeadlines Deadline[]           @relation("DeadlineOwner")
  completions    DeadlineCompletion[]
  assignedTasks  Task[]               @relation("TaskAssignee")
  createdTasks   Task[]               @relation("TaskCreator")
  reminderLogs   ReminderLog[]

  @@map("users")
}

model Group {
  id         String   @id @default(uuid())
  name       String
  inviteCode String   @unique @map("invite_code")
  createdAt  DateTime @default(now()) @map("created_at")

  members   GroupMember[]
  subjects  Subject[]
  deadlines Deadline[]
  tasks     Task[]

  @@map("groups")
}

model GroupMember {
  groupId  String    @map("group_id")
  userId   String    @map("user_id")
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model Subject {
  id      String  @id @default(uuid())
  groupId String  @map("group_id")
  name    String
  teacher String?
  color   String  @default("#3B82F6")

  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  deadlines Deadline[]

  @@unique([groupId, name])
  @@map("subjects")
}

/// groupId = null → personal deadline (visible to the owner only).
model Deadline {
  id          String   @id @default(uuid())
  title       String
  description String?
  dueAt       DateTime @map("due_at")
  priority    Priority @default(MEDIUM)
  ownerId     String   @map("owner_id")
  groupId     String?  @map("group_id")
  subjectId   String?  @map("subject_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner        User                 @relation("DeadlineOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  group        Group?               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject      Subject?             @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  completions  DeadlineCompletion[]
  tasks        Task[]
  reminderLogs ReminderLog[]

  @@index([groupId, dueAt])
  @@index([ownerId, dueAt])
  @@map("deadlines")
}

/// Personal completion mark of a deadline (US-14).
model DeadlineCompletion {
  deadlineId  String   @map("deadline_id")
  userId      String   @map("user_id")
  completedAt DateTime @default(now()) @map("completed_at")

  deadline Deadline @relation(fields: [deadlineId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([deadlineId, userId])
  @@index([userId])
  @@map("deadline_completions")
}

/// Kanban task of a group (US-19, US-20).
model Task {
  id          String     @id @default(uuid())
  groupId     String     @map("group_id")
  title       String
  description String?
  status      TaskStatus @default(TODO)
  position    Int        @default(0)
  assigneeId  String?    @map("assignee_id")
  deadlineId  String?    @map("deadline_id")
  createdById String     @map("created_by_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignee  User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  deadline  Deadline? @relation(fields: [deadlineId], references: [id], onDelete: SetNull)
  createdBy User      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([groupId, status, position])
  @@map("tasks")
}

/// Guards against duplicate reminder e-mails (US-23, rule R2).
model ReminderLog {
  deadlineId String   @map("deadline_id")
  userId     String   @map("user_id")
  sentAt     DateTime @default(now()) @map("sent_at")

  deadline Deadline @relation(fields: [deadlineId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([deadlineId, userId])
  @@map("reminder_logs")
}
