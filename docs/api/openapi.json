  "openapi": "3.0.0",
  "paths": {
    "/api/auth/register": {
      "post": {
        "description": "Email унікальний без урахування регістру; пароль — від 8 символів, у БД зберігається лише bcrypt-хеш. Повертає access-токен і встановлює httpOnly refresh-cookie.",
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Невалідні дані",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "Email уже зареєстровано",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Реєстрація (одразу виконує вхід)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/login": {
