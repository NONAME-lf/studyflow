  "info": {
    "title": "StudyFlow API",
    "description": "REST API планувальника навчальних дедлайнів для студентських груп. Захищені ендпоінти потребують access-токена (Authorize → Bearer).",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": "Реєстрація, вхід, токени"
    },
    {
      "name": "users",
      "description": "Профіль поточного користувача"
    },
    {
      "name": "groups",
      "description": "Групи, учасники, ролі, коди запрошення"
    },
    {
      "name": "health",
      "description": "Стан сервісу"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "student@studyflow.dev"
          },
          "password": {
            "type": "string",
            "example": "Secret123!",
            "minLength": 8,
            "maxLength": 72
          },
          "fullName": {
            "type": "string",
            "example": "Коваль Олена",
            "minLength": 2,
            "maxLength": 100
          }
        },
        "required": [
          "email",
          "password",
          "fullName"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "5eed0000-0000-4000-8000-000000000001"
          },
          "email": {
            "type": "string",
            "example": "artem@studyflow.dev"
          },
          "fullName": {
            "type": "string",
            "example": "Мекшаков Артемій"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-11-10T18:00:00.000Z"
          }
        },
        "required": [
          "id",
          "email",
          "fullName",
          "createdAt"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Access-токен (JWT, 15 хв). Передавати в заголовку Authorization: Bearer …",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9…"
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Пароль має містити щонайменше 8 символів"
